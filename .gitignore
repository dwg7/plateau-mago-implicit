.env

# Source data (large files, not committed)
data/source/*
!data/source/.gitkeep
data/output/*
!data/output/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Node.js
node_modules/
viewer/node_modules/

# Build artifacts
*.jar
*.class

# Editor
.DS_Store
.idea/
*.swp
*.swo

# Temporary files
/tmp/
