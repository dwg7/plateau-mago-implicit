# plateau-mago-implicit environment overrides
# Copy this file to .env and fill in values as needed.
# Do not commit .env to version control.

# Mago 3DTiler — resolve TBD_VERIFIED_SOURCE_REQUIRED values before use
# MAGO_VERSION=TBD_VERIFIED_SOURCE_REQUIRED
# MAGO_JAR_URL=TBD_VERIFIED_SOURCE_REQUIRED
# MAGO_JAR_SHA256=TBD_VERIFIED_SOURCE_REQUIRED

# Java options for the tiler container
# JAVA_OPTS=-Xmx4g

# Static server port
# SERVER_PORT=8080

# Concurrency for Mago (number of threads)
# CONCURRENCY=1

# scripts/publish.sh target — remote static host to publish build output to
# via rsync/ssh. See docs/tile-hosting-plan.md. Never commit real values
# for these; auth is via your local SSH config (key-based), not a secret
# stored here.
#
# PUBLISH_HOST is the SSH/rsync target; it can differ from the host the
# files end up publicly reachable at (e.g. behind a Cloudflare Tunnel) —
# set PUBLISH_URL_BASE for that case so the script reports/records the
# real public URL.
# PUBLISH_HOST=spacex.optgeo.org
# PUBLISH_PATH=/home/stars/data/plateau-mago-implicit
# PUBLISH_USER=stars
# PUBLISH_URL_BASE=https://depot.optgeo.org/plateau-mago-implicit
#
# (Previously jaxa.optgeo.org / tunnel.optgeo.org — that host went
# offline 2026-08-31 and this project migrated to the values above.
# See DECISIONS.md D23 and issue #4.)
